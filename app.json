{
  "expo": {
    "name": "HealthShield",
    "slug": "HealthShield",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "healthshield",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.roshan.shikhare.HealthShield",
      "infoPlist": {
        "LSApplicationCategoryType": "public.app-category.healthcare-fitness"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E3A8A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.roshan.shikhare.HealthShield",
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_SLEEP"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E3A8A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 128,
          "dark": {
            "backgroundColor": "#0A101C",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#2563EB",
          "defaultChannel": "renewals",
          "icon": "./assets/images/android-icon-monochrome.png"
        }
      ],
      "react-native-health-connect",
      "expo-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      [
        "apple-health",
        {
          "healthSharePermission": "HealthShield reads steps, heart rate, and sleep from Apple Health to show your private daily summaries. We never diagnose from this data.",
          "healthUpdatePermission": "HealthShield does not write to Apple Health. This permission string is required by iOS.",
          "backgroundDelivery": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3400a71a-7d74-4408-9874-11ef1852856b"
      }
    }
  }
}
