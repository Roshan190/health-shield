# Supabase (required from Phase 1.1)
# Project: health-shield
# Never commit real keys. Never use the service-role key in the app.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# --- Server-only (NOT for the Expo app) ---
# Phase 4 (D-019): set OpenAI on the Edge Function, never as EXPO_PUBLIC_*.
# Dashboard: Project Settings → Edge Functions → Secrets → OPENAI_API_KEY
# Or CLI: supabase secrets set OPENAI_API_KEY=sk-... --project-ref YOUR_PROJECT_REF
# OPENAI_API_KEY=  # do not put this in .env for the mobile app
