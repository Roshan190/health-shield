# Supabase (required from Phase 1.1)
# Project: health-shield
# Never commit real keys. Never use the service-role key in the app.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# --- Mapbox map tiles (in-app Map UI via WebView + Mapbox GL JS) ---
# Public token only (starts with pk.). Never put a secret (sk.) token here.
# Works in Expo Go after restart — no Google Maps key, no native Mapbox SDK rebuild.
# EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk....

# --- Server-only (NOT for the Expo app) ---
# Phase 4 (D-019) + policy PDF (D-022) + document Q&A (D-031): set OpenAI on the Edge Function, never as EXPO_PUBLIC_*.
# Dashboard: Project Settings → Edge Functions → Secrets → OPENAI_API_KEY
# Or CLI: supabase secrets set OPENAI_API_KEY=sk-... --project-ref YOUR_PROJECT_REF
# OPENAI_API_KEY=  # do not put this in .env for the mobile app
# Nearby hospitals Search: MAPBOX_ACCESS_TOKEN on Edge Functions only (not here).

# --- EAS production APK (D-028) ---
# Do not put these values in eas.json. Set the same three EXPO_PUBLIC_* names on
# Expo → Environment variables for `production` (plaintext or sensitive, not secret).
# Then: eas build -p android --profile production
# Never set OPENAI_API_KEY or Mapbox sk. on EAS.

# --- Password reset (D-039) ---
# App reset emails redirect to https://health-shield.in/app-reset (static bounce, no keys).
# Do not put a custom redirect URL here. Founder allow-lists that URL + healthshield://reset-password
# in Supabase Auth → URL configuration. Smoke on a dev client / APK, not Expo Go.

# --- Doctor portal (D-035 / D-038) ---
# Shown in the app when you grant a visit pack. Local default is http://localhost:3000.
# Production EAS must set this to https://portal.health-shield.in (plaintext, not secret).
# EXPO_PUBLIC_DOCTOR_PORTAL_URL=http://localhost:3000
